  "legal": {
    "disclaimer": "ExperienceHub একটি কমিউনিটি প্রকল্প এবং এটি প্রাথমিক খসড়া লেখা, আইনি পরামর্শ নয়।",
    "about": {
      "title": "ExperienceHub সম্পর্কে",
      "p1": "ExperienceHub বাংলাদেশে পণ্য ব্যবহারের আসল অভিজ্ঞতার একটি কমিউনিটি জ্ঞানভাণ্ডার — সৎ রিভিউ, ব্যবহারকারীদের সত্যিকারের সমস্যা, এবং যে সমাধানগুলো কাজ করেছে।",
      "p2": "যে কেউ পড়তে পারেন। রিভিউ দিতে, সমস্যা জানাতে, সমাধান শেয়ার করতে বা প্রশ্ন করতে সাইন ইন করুন। একদম নতুন অ্যাকাউন্টের কনটেন্ট অল্প সময়ের জন্য পর্যালোচনায় থাকে; তারপর সরাসরি প্রকাশিত হয়।",
      "p3": "এটি একজন মানুষ তৈরি ও পরিচালনা করছেন, খোলাখুলিভাবে, একটি পরীক্ষা হিসেবে। মতামত ও সংশোধন স্বাগত।"
    },
    "policy": {
      "title": "কনটেন্ট নীতি",
      "p1": "নিজের অভিজ্ঞতা থেকে লিখুন। রিভিউ হওয়া উচিত এমন পণ্যের যা আপনি সত্যিই ব্যবহার করেছেন; সমস্যা হওয়া উচিত এমন যা আপনি নিজে সম্মুখীন হয়েছেন।",
      "p2": "কোনো স্প্যাম বা বিজ্ঞাপন নয়, ভুয়া বা সাজানো কনটেন্ট নয়, আপত্তিকর বা অবমাননাকর কিছু নয়, এবং অন্যদের ব্যক্তিগত তথ্য নয়।",
      "p3": "যে কেউ কনটেন্ট ফ্ল্যাগ করতে পারেন। মডারেটররা ফ্ল্যাগ পর্যালোচনা করে নিয়ম ভাঙা কনটেন্ট লুকাতে পারেন; বারবার নিয়ম ভাঙলে অ্যাকাউন্ট স্থগিত হতে পারে।"
    },
    "terms": {
      "title": "ব্যবহারের শর্তাবলি",
      "p1": "সাইটটি বৈধভাবে ও সদিচ্ছায় ব্যবহার করুন। আপনি যা পোস্ট করেন তার মালিকানা আপনার থাকে, তবে আপনি ExperienceHub-কে প্ল্যাটফর্মে তা প্রদর্শন ও বিতরণের অধিকার দেন।",
      "p2": "এখানকার তথ্য কমিউনিটি-প্রদত্ত এবং যেমন আছে তেমন দেওয়া — গুরুত্বপূর্ণ কিছু (দাম, ওয়ারেন্টি, স্পেসিফিকেশন) নির্ভর করার আগে বিক্রেতা বা নির্মাতার সাথে যাচাই করুন।",
      "p3": "যেসব অ্যাকাউন্ট প্ল্যাটফর্মের অপব্যবহার করে সেগুলো স্থগিত বা সরানো হতে পারে। এই শর্তাবলি পরিবর্তিত হতে পারে; ব্যবহার চালিয়ে যাওয়ার অর্থ আপনি বর্তমান সংস্করণ মেনে নিচ্ছেন।"
    },
    "privacy": {
      "title": "গোপনীয়তা",
      "p1": "সাইন ইন করলে আপনার সাইন-ইন প্রোভাইডার থেকে নাম, ইমেইল ও প্রোফাইল ছবি সংরক্ষণ করা হয়। এটি আপনাকে চিহ্নিত করতে ও আপনার অবদান যুক্ত করতে ব্যবহৃত হয়।",
      "p2": "আপনার সার্চ লগ করা হয় (যতটা সম্ভব ব্যক্তিগতভাবে আপনার সাথে যুক্ত না করে) যাতে আমরা দেখতে পারি মানুষ কোন পণ্য খোঁজে ও পায় না। আপলোড করা ছবি সাইট চালানো সার্ভারে সংরক্ষিত হয়।",
      "p3": "আমরা আপনার তথ্য বিক্রি করি না বা তৃতীয় পক্ষের বিজ্ঞাপন ট্র্যাকিং চালাই না। আপনি আপনার অ্যাকাউন্ট ও তার কনটেন্ট মুছে ফেলার অনুরোধ করতে পারেন।"
    }
